DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_tracker?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"
PORT=4000
NODE_ENV="development"

# Comma-separated list of allowed frontend origins (no trailing slash).
# Local dev only needs the Vite dev server; add your deployed frontend URL
# too when hosting split across two domains (e.g. GitHub Pages + Render).
CLIENT_ORIGIN="http://localhost:5173"
# CLIENT_ORIGIN="http://localhost:5173,https://your-username.github.io"

# "lax" is correct when frontend and API are on the same site. If you split
# them across two different domains (GitHub Pages frontend + a separately
# hosted API), browsers require SameSite=None for the auth cookie to be sent
# cross-site — set this to "none" in that deployment's environment only.
# COOKIE_SAME_SITE="none"

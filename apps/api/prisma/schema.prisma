// Fitness & Nutrition Tracking System — Prisma schema
// Design principle: fitness facts are historical events (INSERT), never overwritten.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  WEIGHT_LOSS
  WEIGHT_GAIN
  WEIGHT_MAINTENANCE
  FITNESS_IMPROVEMENT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum ExerciseCategory {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
  FULL_BODY
  CARDIO
}

enum CardioType {
  RUNNING
  JOGGING
  WALKING
  CYCLING
  OTHER
}

enum CardioStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// Distinguishes where a piece of activity/calorie data originated —
// required by the "never conflate consumed vs burned, manual vs device" rule.
enum DataSource {
  MANUAL
  GPS
  WEARABLE
}

// ------------------------------------------------------------------
// USERS & PROFILE
// ------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  goals               Goal[]
  bodyMeasurements    BodyMeasurement[]
  meals               Meal[]
  workouts            Workout[]
  cardioActivities    CardioActivity[]
  wearableDevices     WearableDevice[]
  wearableActivities  WearableActivityRecord[]
  progressSnapshots   ProgressSnapshot[]
  reports             Report[]
  refreshTokens       RefreshToken[]
  customFoods         Food[]                    @relation("UserCustomFoods")

  posts                   Post[]
  likes                   Like[]
  comments                Comment[]
  following               Follow[]        @relation("Following")
  followers               Follow[]        @relation("Followers")
  sentFollowRequests      FollowRequest[] @relation("SentFollowRequests")
  receivedFollowRequests  FollowRequest[] @relation("ReceivedFollowRequests")
  sentMessages            Message[]       @relation("SentMessages")

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MessagingPrivacy {
  EVERYONE
  FOLLOWING // only people the profile owner already follows can message them
  MUTUALS   // only people who follow each other can message
  NO_ONE
}

model Profile {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  // Nullable rather than required so existing rows survive a migration
  // without a manual backfill — auto-generated at registration for new
  // accounts, editable afterward, enforced unique + case-sensitive.
  username       String?          @unique
  bio            String?
  avatarUrl      String?
  // Private accounts hide posts from non-approved followers. Basic profile
  // info (name, bio, avatar, follower/following counts) stays visible to
  // everyone regardless — only posts are gated.
  isPrivate      Boolean          @default(false)
  messagingPrivacy MessagingPrivacy @default(EVERYONE)
  dateOfBirth    DateTime?
  sex            Sex?
  heightCm       Float?
  activityLevel  ActivityLevel    @default(MODERATE)
  // When this user last opened the notification bell — used as the
  // baseline for "new posts by people you follow" notifications, so a
  // brand-new account isn't flooded with every historical post the moment
  // they follow someone. Defaults to now() so it starts at "nothing is new
  // yet" rather than "everything since the epoch is new."
  notificationsLastCheckedAt DateTime? @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([username])
}

// ------------------------------------------------------------------
// GOALS & BODY MEASUREMENTS (historical, append-only)
// ------------------------------------------------------------------

model Goal {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           GoalType
  startingValue  Float
  targetValue    Float
  currentValue   Float
  startDate      DateTime   @default(now())
  targetDate     DateTime?
  status         GoalStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId, status])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  bodyFatPct Float?
  notes      String?
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

// ------------------------------------------------------------------
// NUTRITION
// ------------------------------------------------------------------

// A Food with createdByUserId = null is part of the shared, admin-managed
// library (visible to everyone). A Food with createdByUserId set is a
// personal library entry, visible only to its owner.
model Food {
  id              String   @id @default(cuid())
  name            String
  servingSize     String
  // How many grams the stored nutrition values correspond to (e.g. 100 for
  // "per 100g" foods). Nullable because not every food is gram-based (a
  // food logged as "1 cup" or "1 medium" doesn't have a meaningful gram
  // equivalent) — the custom-gram-amount input on the Nutrition page only
  // appears when this is set.
  gramsPerServing Float?
  calories        Float
  proteinG        Float
  carbsG          Float
  fatG            Float
  fiberG          Float
  createdByUserId String?
  createdByUser   User?    @relation("UserCustomFoods", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mealItems MealItem[]

  @@index([name])
  @@index([createdByUserId])
}

model Meal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      MealType
  loggedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())

  items MealItem[]

  @@index([userId, loggedAt])
}

model MealItem {
  id       String @id @default(cuid())
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id])
  quantity Float  @default(1) // multiplier of the food's serving size

  @@index([mealId])
}

// ------------------------------------------------------------------
// EXERCISES & WORKOUTS
// ------------------------------------------------------------------

model Exercise {
  id           String           @id @default(cuid())
  name         String
  category     ExerciseCategory
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([category])
}

model Workout {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  performedAt    DateTime @default(now())
  durationMin    Int?
  caloriesBurned Float?
  // Cached sum of sets × reps × weight across every exercise in this
  // workout (Hevy-style "total volume"), computed at creation. Cached
  // rather than derived on every read so weekly/monthly report aggregation
  // doesn't need to re-join and re-multiply WorkoutExercise rows.
  totalVolumeKg  Float    @default(0)
  notes          String?
  createdAt      DateTime @default(now())

  exercises WorkoutExercise[]

  @@index([userId, performedAt])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  sets       Int
  reps       Int
  weightKg   Float?

  @@index([workoutId])
}

// ------------------------------------------------------------------
// GPS CARDIO
// ------------------------------------------------------------------

model CardioActivity {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           CardioType
  status         CardioStatus @default(ACTIVE)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  durationSec    Int          @default(0)
  distanceMeters Float        @default(0)
  avgPaceSecKm   Float?
  avgSpeedKmh    Float?
  caloriesBurned Float        @default(0)
  source         DataSource   @default(GPS)
  createdAt      DateTime     @default(now())

  routePoints RoutePoint[]

  @@index([userId, startedAt])
}

model RoutePoint {
  id         String         @id @default(cuid())
  activityId String
  activity   CardioActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  elevationM Float?
  recordedAt DateTime

  @@index([activityId, recordedAt])
}

// ------------------------------------------------------------------
// WEARABLES
// ------------------------------------------------------------------

model WearableDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   // e.g. "mock", "fitbit", "garmin"
  deviceName  String
  connectedAt DateTime @default(now())
  isActive    Boolean  @default(true)

  activityRecords WearableActivityRecord[]

  @@index([userId])
}

model WearableActivityRecord {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String
  device         WearableDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date           DateTime
  steps          Int?
  caloriesBurned Float?
  avgHeartRate   Int?
  activeMinutes  Int?
  source         DataSource     @default(WEARABLE)
  createdAt      DateTime       @default(now())

  @@index([userId, date])
}

// ------------------------------------------------------------------
// PROGRESS & REPORTS
// ------------------------------------------------------------------

// A daily rollup snapshot, computed and cached so the dashboard/progress
// pages don't have to re-aggregate raw tables on every request.
model ProgressSnapshot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  weightKg          Float?
  caloriesConsumed  Float    @default(0)
  proteinG          Float    @default(0)
  carbsG            Float    @default(0)
  fatG              Float    @default(0)
  fiberG            Float    @default(0)
  caloriesBurned    Float    @default(0)
  cardioDistanceM   Float    @default(0)
  workoutMinutes    Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model Report {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  summaryJson   Json     // computed summary payload (see reports.service.ts)
  createdAt     DateTime @default(now())

  @@index([userId, periodStart])
}

// ------------------------------------------------------------------
// SOCIAL: posts, follows, follow requests, messaging
// ------------------------------------------------------------------

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes            Like[]
  comments         Comment[]
  sharedInMessages Message[]

  @@index([authorId, createdAt])
}

// One like per (post, user) — enforced by the unique constraint, so the
// "toggle like" endpoint can just check existence rather than needing a
// separate "already liked" query.
model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// An established follow relationship. For a private account, this row is
// only created once the target approves a FollowRequest; for a public
// account it's created directly.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum FollowRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Only created when following a private account. Approving one creates the
// corresponding Follow row; rejecting just marks the request REJECTED so it
// isn't re-shown as pending (the requester can request again later).
model FollowRequest {
  id          String              @id @default(cuid())
  requesterId String
  requester   User                @relation("SentFollowRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User                @relation("ReceivedFollowRequests", fields: [targetId], references: [id], onDelete: Cascade)
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

// One conversation per unique pair of users. userAId/userBId are always
// stored with the lexicographically smaller user id first, so a lookup for
// "the conversation between X and Y" is deterministic regardless of who
// started it or who's asking.
model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime  @default(now())
  // When each participant last opened this conversation (set whenever they
  // fetch its messages). Null = never opened, meaning every message from
  // the other person is unread. Used to compute unread-message
  // notifications without a separate per-message read table.
  lastReadByA DateTime?
  lastReadByB DateTime?
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  // Set when this message is a "share" of a post — the client renders a
  // mini post-card in the bubble instead of (or alongside) plain text.
  sharedPostId   String?
  sharedPost     Post?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
